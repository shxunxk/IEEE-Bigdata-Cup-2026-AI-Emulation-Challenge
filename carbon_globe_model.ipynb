target = check_ytrain[age_idx, site_idx, year]
# (7)

# Concatenate features
x_combined = np.concatenate([x, y_previous], axis=-1)
# (12, 143)

# Convert to PyTorch and add batch dimension
x_tensor = torch.tensor(x_combined, dtype=torch.float32).unsqueeze(0)
target_tensor = torch.tensor(target, dtype=torch.float32).unsqueeze(0)

# Model prediction
model = LSTMModel()
output = model(x_tensor)

print("Input:", x_tensor.shape)
print("Output:", output.shape)
print("Target:", target_tensor.shape)




rmse = torch.sqrt(torch.mean((output - target_tensor) ** 2))
print("RMSE:", rmse.item())





import torch
import torch.nn as nn


class TransformerModel(nn.Module):

    def __init__(
        self,
        input_dim=144,
        d_model=128,
        nhead=8,
        num_layers=3,
        dim_feedforward=256,
        output_dim=7,
        dropout=0.1
    ):
        super().__init__()

        # 144 → 128
        self.input_projection = nn.Linear(input_dim, d_model)

        # Learnable positional embeddings for 12 months
        self.pos_embedding = nn.Parameter(
            torch.zeros(1, d_model)
        )

        encoder_layer = nn.TransformerEncoderLayer(
            d_model=d_model,
            nhead=nhead,
            dim_feedforward=dim_feedforward,
            dropout=dropout,
            batch_first=True,
            norm_first=True
        )

        self.transformer = nn.TransformerEncoder(
            encoder_layer,
            num_layers=num_layers
        )

        # 128 → 7
        self.output_layer = nn.Linear(d_model, output_dim)

    def forward(self, x):

        # x: (144)

        x = self.input_projection(x)
        # (batch, 128)

        x = x + self.pos_embedding
        # (batch, 128)

        x = self.transformer(x)
        # (batch, 128)

        output = self.output_layer(x)
        # (batch, 7)

        return output


import numpy as np
import torch

model = TransformerModel(input_dim=144)

err = 0
site_idx = 0

previous_state = last_state[site_idx, 0]

for i in range(5):

    # Current year's environmental input
    x = annual_mean[site_idx, i]

    # Previous state
    y_previous = previous_state

    # Actual next state
    target = last_state[site_idx, i + 1]

    # Age
    age = 1
    age_feature = np.array([age / 500.0])

    # 136 + 7 + 1 = 144
    x_combined = np.concatenate(
        [x, y_previous, age_feature]
    )

    x_tensor = torch.tensor(
        x_combined,
        dtype=torch.float32
    ).unsqueeze(0)

    target_tensor = torch.tensor(
        target,
        dtype=torch.float32
    ).unsqueeze(0)

    # Prediction
    output = model(x_tensor)

    # Squared error
    err += torch.sum((output - target_tensor) ** 2)

    print(f"Year {i+1} prediction:", output)

    # IMPORTANT: prediction becomes next year's state
    previous_state = output.detach().numpy()[0]

rmse = torch.sqrt(err / (5 * 7))

print("RMSE:", rmse.item())


print("Input:", x_tensor.shape)
print("Output:", output.shape)
print("Target:", target_tensor.shape)
