import torch
import torch.nn as nn

class LSTMModel(nn.Module):
    def __init__(self, input_dim=143, hidden_dim=128, layer_dim=2, output_dim=7):
        super().__init__()

        self.lstm = nn.LSTM(
            input_size=input_dim,
            hidden_size=hidden_dim,
            num_layers=layer_dim,
            batch_first=True,
            dropout=0.2
        )

        self.fc = nn.Linear(hidden_dim, output_dim)

    def forward(self, x):

        out, (hn, cn) = self.lstm(x)
        out = self.fc(out)

        return out


import numpy as np
import torch

age_idx = 0
site_idx = 0
year = 1

# Environmental input for Year 1
x = check_xtrain[site_idx, year-1]      
# (136)

# Initial ecosystem state Y0
y_previous = check_ytrain[age_idx, site_idx, year-1]
# (7)

# Ground-truth Y1
target = check_ytrain[age_idx, site_idx, year]
# (7)

# Concatenate features
x_combined = np.concatenate([x, y_previous], axis=-1)
# (12, 143)

# Convert to PyTorch and add batch dimension
x_tensor = torch.tensor(x_combined, dtype=torch.float32).unsqueeze(0)
target_tensor = torch.tensor(target, dtype=torch.float32).unsqueeze(0)

# Model prediction
model = LSTMModel()
output = model(x_tensor)

print("Input:", x_tensor.shape)
print("Output:", output.shape)
print("Target:", target_tensor.shape)




rmse = torch.sqrt(torch.mean((output - target_tensor) ** 2))
print("RMSE:", rmse.item())


import torch
import torch.nn as nn


class TransformerModel(nn.Module):

    def __init__(
        self,
        input_dim=144,
        d_model=128,
        nhead=8,
        num_layers=3,
        dim_feedforward=256,
        output_dim=7,
        dropout=0.1
    ):
        super().__init__()

        # 144 → 128
        self.input_projection = nn.Linear(input_dim, d_model)

        # Learnable positional embeddings for 12 months
        self.pos_embedding = nn.Parameter(
            torch.zeros(1, d_model)
        )

        encoder_layer = nn.TransformerEncoderLayer(
            d_model=d_model,
            nhead=nhead,
            dim_feedforward=dim_feedforward,
            dropout=dropout,
            batch_first=True,
            norm_first=True
        )

        self.transformer = nn.TransformerEncoder(
            encoder_layer,
            num_layers=num_layers
        )

        # 128 → 7
        self.output_layer = nn.Linear(d_model, output_dim)

    def forward(self, x):

        # x: (144)

        x = self.input_projection(x)
        # (batch, 128)

        x = x + self.pos_embedding
        # (batch, 128)

        x = self.transformer(x)
        # (batch, 128)

        output = self.output_layer(x)
        # (batch, 7)

        return output


import numpy as np
import torch

age_idx = 0
site_idx = 0
year = 1

# Environmental input for Year 1
x = annual_mean[site_idx, year-1]      
# (136)

# Initial ecosystem state Y0
y_previous = last_state[age_idx, site_idx, year-1]
# (7)

# Ground-truth Y1
target = last_state[age_idx, site_idx, year]
# (7)

# Concatenate features
age = 1

age_feature = np.full((1), age)

x_combined = np.concatenate(
    [x, y_previous, age_feature],
    axis=-1
)# (144)

# Convert to PyTorch and add batch dimension
x_tensor = torch.tensor(x_combined, dtype=torch.float32).unsqueeze(0)
target_tensor = torch.tensor(target, dtype=torch.float32).unsqueeze(0)

# Model prediction
model = TransformerModel(input_dim=144)
output = model(x_tensor)

print("Input:", x_tensor.shape)
print("Output:", output.shape)
print("Target:", target_tensor.shape)




rmse = torch.sqrt(torch.mean((output - target_tensor) ** 2))
print("RMSE:", rmse.item())
