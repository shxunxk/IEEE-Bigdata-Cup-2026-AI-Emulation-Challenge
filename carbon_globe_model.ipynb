import torch
import torch.nn as nn

class LSTMModel(nn.Module):
    def __init__(self, input_dim=143, hidden_dim=128, layer_dim=2, output_dim=7):
        super().__init__()

        self.lstm = nn.LSTM(
            input_size=input_dim,
            hidden_size=hidden_dim,
            num_layers=layer_dim,
            batch_first=True,
            dropout=0.2
        )

        self.fc = nn.Linear(hidden_dim, output_dim)

    def forward(self, x):

        out, (hn, cn) = self.lstm(x)
        out = self.fc(out)

        return out


import numpy as np
import torch

age_idx = 0
site_idx = 0
year = 1

# Environmental input for Year 1
x = check_xtrain[site_idx, year-1]      
# (136)

# Initial ecosystem state Y0
y_previous = check_ytrain[age_idx, site_idx, year-1]
# (7)

